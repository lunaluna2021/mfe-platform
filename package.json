{
  "name": "mfe-platform",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "scripts": {
    "start": "concurrently -k -n mfes,static,host -c blue,green,magenta \"npm:watch:mfes\" \"npm:serve:mfes\" \"npm:serve:host\"",
    "watch:mfes": "nx run-many -t build -p customer-mfe calendar-mfe report-mfe -c development --watch --parallel=3",
    "serve:mfes": "http-server dist -p 4300 -c-1 --silent",
    "serve:host": "nx serve host",
    "build": "nx run-many -t build -p host customer-mfe calendar-mfe report-mfe",
    "build:site": "npm run build && node tools/assemble-site.mjs",
    "lint": "nx run-many -t lint"
  },
  "dependencies": {
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/elements": "~22.2.0",
    "@angular/forms": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/router": "~22.2.0",
    "@supabase/postgrest-js": "^2.119.2",
    "@supabase/supabase-js": "^2.119.2",
    "rxjs": "~7.8.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.7.5",
    "@analogjs/vitest-angular": "2.7.5",
    "@angular-devkit/core": "~22.2.0",
    "@angular-devkit/schematics": "~22.2.0",
    "@angular/build": "~22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "~22.2.0",
    "@angular/language-service": "~22.2.0",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "24.0.0",
    "@nx/devkit": "24.0.0",
    "@nx/eslint": "24.0.0",
    "@nx/eslint-plugin": "24.0.0",
    "@nx/js": "24.0.0",
    "@nx/vite": "24.0.0",
    "@nx/vitest": "24.0.0",
    "@nx/web": "24.0.0",
    "@nx/workspace": "24.0.0",
    "@schematics/angular": "~22.2.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "^24.0.0",
    "@typescript-eslint/utils": "^8.40.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "angular-eslint": "22.6.0",
    "concurrently": "^10.0.7",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "http-server": "^14.1.1",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "24.0.0",
    "prettier": "^3.8.1",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "tsx": "^4.20.5",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.40.0",
    "vite": "8.3.5",
    "vitest": "^5.1.0"
  },
  "packageManager": "npm@10.9.2"
}
