{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@mfe-platform/shared-auth": ["./libs/shared-auth/src/index.ts"],
      "@mfe-platform/shared-contracts": [
        "./libs/shared-contracts/src/index.ts"
      ],
      "@mfe-platform/shared-data-api": ["./libs/shared-data-api/src/index.ts"],
      "@mfe-platform/shared-event-bus": [
        "./libs/shared-event-bus/src/index.ts"
      ],
      "@mfe-platform/shared-mfe-element": [
        "./libs/shared-mfe-element/src/index.ts"
      ],
      "@mfe-platform/shared-mfe-element/standalone": [
        "./libs/shared-mfe-element/src/standalone.ts"
      ],
      "@mfe-platform/shared-mocks": ["./libs/shared-mocks/src/index.ts"],
      "@mfe-platform/shared-permission": [
        "./libs/shared-permission/src/index.ts"
      ],
      "@mfe-platform/shared-ui": ["./libs/shared-ui/src/index.ts"]
    },
    "resolveJsonModule": true
  },
  "exclude": ["node_modules", "tmp"]
}
