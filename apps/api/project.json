{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "tags": ["type:backend"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/target"],
      "options": {
        "command": "node tools/maven.mjs apps/api -B -q package -DskipTests"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/maven.mjs apps/api -B test"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "node tools/maven.mjs apps/api spring-boot:run -Dspring-boot.run.profiles=local"
      }
    }
  }
}
